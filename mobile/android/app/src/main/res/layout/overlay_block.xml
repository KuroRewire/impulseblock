<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/overlay_mark"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="@string/overlay_mark_description"
        android:src="@drawable/ic_pause_mark" />

    <TextView
        android:id="@+id/overlay_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/overlay_headline"
        android:textColor="@color/overlay_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/overlay_supporting"
        android:textColor="@color/overlay_text_dim"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/overlay_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/overlay_text_dim"
        android:textSize="14sp" />

    <Button
        android:id="@+id/overlay_not_now"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/overlay_not_now"
        android:textAllCaps="false"
        android:textColor="@color/overlay_text"
        android:textSize="17sp" />

    <Button
        android:id="@+id/overlay_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_secondary"
        android:text="@string/overlay_continue"
        android:textAllCaps="false"
        android:textColor="@color/overlay_text_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/overlay_duration_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/overlay_allow_5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/overlay_allow_5"
            android:textAllCaps="false"
            android:textColor="@color/overlay_text" />

        <Button
            android:id="@+id/overlay_allow_15"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/overlay_allow_15"
            android:textAllCaps="false"
            android:textColor="@color/overlay_text" />
    </LinearLayout>
</LinearLayout>
